# ─── Kikoba Client — Environment Variables Example ──────────────────────────
# Copy to .env and fill in your values

# dev: /api   (proxied by Vite to VITE_API_TARGET)
# prod: https://api.kikoba.example.com
VITE_API_URL=/api

# Only needed during `npm run dev` — the proxy forwards /api to this address
VITE_API_TARGET=http://localhost:5000
